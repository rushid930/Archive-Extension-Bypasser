{
    "manifest_version": 3,
    "name": "Page Archive Button",
    "version": "1.0",
    "description": "Save the current page to the Internet Archive or view existing snapshots.",
    "permissions": [
        "tabs"
    ],
    "action": {
        "default_title": "Archive this page",
        "default_popup": "popup.html"
    },
    "host_permissions": [
        "https://archive.org/*"
    ],
    "background": {
        "service_worker": "popup.js"
    }
}